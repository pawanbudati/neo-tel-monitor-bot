# Telegram Bot Configuration
# 1. Talk to @BotFather on Telegram and send /newbot to create a monitor bot
# 2. Paste the bot token here:
TELEGRAM_BOT_TOKEN=

# 3. Your personal Telegram User ID (e.g. 123456789).
# If you don't know it, leave it blank, run the bot, and message it — it will reply with your ID!
# Multiple IDs can be separated by commas (e.g. 123456789,987654321)
TELEGRAM_ALLOWED_USER_IDS=

# Systemd Service Names on the GCP VM
CONSUMER_SERVICE_NAME=neo-tel-order-processor
PRODUCER_SERVICE_NAME=neo-tel-signal-producer
KAFKA_SERVICE_NAME=docker

# Path to active trades JSON file (relative to bot.py or absolute)
ACTIVE_TRADES_PATH=../consumer/runtime/active_trades.json
